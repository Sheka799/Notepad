# Шаблон переменных

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notepad

# --- Backend ---
JWT_SECRET=change-me
COOKIE_DOMAIN=example.com
FRONTEND_URL=https://notepad.example.com

# --- S3-хранилище аватаров ---
S3_URL=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# --- Frontend (встраиваются в JS-бандл на этапе сборки — build args) ---
# SERVER_URL обязан быть ПУБЛИЧНЫМ адресом бэкенда, доступным из браузера
SERVER_URL=https://api.notepad.example.com
DOMAIN=example.com
